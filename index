<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Profile Sweep</title>
<style>
  :root {
    --bg: #0f1115;
    --panel: #171a21;
    --border: #2a2f3a;
    --text: #e6e9ef;
    --muted: #8b93a1;
    --found: #22c55e;
    --not-found: #ef4444;
    --uncertain: #f59e0b;
    --error: #6b7280;
    --checking: #3b82f6;
    --accent: #6366f1;
    --radius: 10px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    width: 480px;
    min-height: 460px;
    background: var(--bg);
    color: var(--text);
    font: 13px/1.45 system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    padding: 14px;
  }
  h1 { font-size: 15px; font-weight: 600; margin: 0 0 2px; letter-spacing: -0.01em; }
  .sub { color: var(--muted); font-size: 11.5px; margin-bottom: 14px; }

  .label {
    font-size: 10px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin: 0 0 6px;
    font-weight: 600;
  }

  /* ---------- platform picker ---------- */
  .platforms {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
  }
  .platform {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 10px 2px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    user-select: none;
    font: inherit;
    color: inherit;
    transition: border-color .12s, background .12s, transform .06s;
  }
  .platform:hover { border-color: #3a4150; }
  .platform:active { transform: scale(.97); }
  .platform svg { width: 20px; height: 20px; color: var(--muted); transition: color .12s; }
  .platform span { font-size: 9.5px; color: var(--muted); transition: color .12s; }
  .platform.on { border-color: var(--accent); background: rgba(99,102,241,.13); }
  .platform.on svg, .platform.on span { color: var(--text); }

  .row-tools { display: flex; gap: 6px; margin: 8px 0 14px; }
  .mini {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 7px;
    padding: 3px 8px;
    font-size: 10.5px;
    cursor: pointer;
    font: inherit;
  }
  .mini:hover { color: var(--text); border-color: #3a4150; }

  /* ---------- username ---------- */
  .input-row { display: flex; gap: 8px; margin-bottom: 12px; }
  input {
    flex: 1;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    padding: 9px 11px;
    font-size: 13px;
    outline: none;
    font: inherit;
  }
  input:focus { border-color: var(--accent); }
  input:disabled { opacity: .45; cursor: not-allowed; }
  button.primary {
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: var(--radius);
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    font: inherit;
  }
  button.primary:disabled { opacity: .4; cursor: not-allowed; }

  /* ---------- results ---------- */
  #results { display: grid; gap: 6px; margin-bottom: 12px; }
  .result {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 8px 10px;
  }
  .result svg.picon { width: 15px; height: 15px; color: var(--muted); flex-shrink: 0; }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--muted); }
  .dot.found { background: var(--found); }
  .dot.not_found { background: var(--not-found); }
  .dot.uncertain { background: var(--uncertain); }
  .dot.error { background: var(--error); }
  .dot.checking { background: var(--checking); animation: pulse 1s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  .meta { flex: 1; min-width: 0; }
  .name { font-weight: 600; font-size: 12.5px; }
  .detail {
    color: var(--muted); font-size: 10.5px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .actions { display: flex; gap: 6px; flex-shrink: 0; }
  .actions button {
    padding: 4px 9px; font-size: 11px; font-weight: 500;
    border-radius: 7px; cursor: pointer; font: inherit;
    background: transparent; border: 1px solid var(--border); color: var(--text);
  }
  .actions button:hover { border-color: var(--accent); }

  /* ---------- embed ---------- */
  #embed-wrap {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px;
    min-height: 80px;
  }
  #embed-title {
    font-size: 10px; color: var(--muted); margin-bottom: 8px;
    text-transform: uppercase; letter-spacing: .07em;
  }
  #embed-container { overflow: auto; }
  .empty { color: var(--muted); font-size: 11.5px; padding: 6px 2px; }
  .banner {
    font-size: 10.5px; color: var(--muted);
    border-top: 1px solid var(--border);
    margin-top: 12px; padding-top: 10px; line-height: 1.5;
  }
</style>
</head>
<body>

<h1>Profile Sweep</h1>
<div class="sub">Select platforms → enter username → scan. Runs entirely on this device.</div>

<div class="label">1 · Platforms</div>
<div class="platforms" id="platforms"></div>
<div class="row-tools">
  <button class="mini" id="all">Select all</button>
  <button class="mini" id="none">Clear</button>
</div>

<div class="label">2 · Username</div>
<div class="input-row">
  <input id="username" placeholder="Choose a platform first" autocomplete="off" spellcheck="false" disabled>
  <button class="primary" id="scan" disabled>Scan</button>
</div>

<div id="results"></div>

<div id="embed-wrap">
  <div id="embed-title">Embed preview</div>
  <div id="embed-container"><div class="empty">Run a scan, then press “Embed” on a found profile.</div></div>
</div>

<div class="banner">
  Results are heuristic leads, not proof of ownership. TikTok uses oEmbed; YouTube channel embeds use a deprecated legacy iframe and may fail.
</div>

<div id="fb-root"></div>

<script>
/* ============================================================
   1. ICONS (inline SVG — no network, no icon font)
   ============================================================ */
const ICONS = {
  instagram: `<svg class="picon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>`,
  facebook:  `<svg class="picon" viewBox="0 0 24 24" fill="currentColor"><path d="M13.4 21v-8.1h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2.1H7.4v3.1h2.7V21h3.3z"/></svg>`,
  youtube:   `<svg class="picon" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15.5v-7l6 3.5-6 3.5z"/></svg>`,
  x:         `<svg class="picon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 3h3.2l-7 8 8.3 10h-6.5l-5.1-6.2L4.6 21H1.4l7.5-8.6L1 3h6.6l4.6 5.7L17.5 3zm-1.1 16h1.8L7.7 4.9H5.8L16.4 19z"/></svg>`,
  tiktok:    `<svg class="picon" viewBox="0 0 24 24" fill="currentColor"><path d="M12.5 2h2.9c.2 1.6 1.2 3 2.7 3.6.6.3 1.3.4 2 .4v2.9a8.8 8.8 0 0 1-4.6-1.3v6.7a6.4 6.4 0 1 1-5.6-6.4v3a3.4 3.4 0 1 0 2.6 3.3V2z"/></svg>`
};

/* ============================================================
   2. PLATFORM CONFIGURATION
   ============================================================ */
const SITES = [
  {
    id: 'instagram', name: 'Instagram', short: 'Instagram',
    url: u => `https://www.instagram.com/${u}/`,
    mode: 'html',
    notFoundPatterns: [/Page Not Found/i, /Sorry, this page isn't available/i],
    uncertainPatterns: [/login/i]
  },
  {
    id: 'facebook', name: 'Facebook', short: 'Facebook',
    url: u => `https://www.facebook.com/${u}`,
    mode: 'html',
    notFoundPatterns: [/content isn't available/i, /This content isn't available/i],
    uncertainPatterns: [/log in/i, /login/i]
  },
  {
    id: 'youtube', name: 'YouTube', short: 'YouTube',
    url: u => `https://www.youtube.com/@${u}`,
    mode: 'html',
    notFoundPatterns: [/This channel does not exist/i, /This page isn't available/i]
  },
  {
    id: 'x', name: 'X / Twitter', short: 'X',
    url: u => `https://x.com/${u}`,
    mode: 'html',
    notFoundPatterns: [/This account doesn’t exist/i, /Account suspended/i],
    uncertainPatterns: [/Something went wrong/i]
  },
  {
    id: 'tiktok', name: 'TikTok', short: 'TikTok',
    url: u => `https://www.tiktok.com/@${u}`,
    mode: 'oembed',
    oembedUrl: u => `https://www.tiktok.com/oembed?url=${encodeURIComponent(`https://www.tiktok.com/@${u}`)}`
  }
];

/* ============================================================
   3. STATE
   ============================================================ */
const selected = new Set();   // nothing selected by default — forces step 1
let results = [];
let scanning = false;

const $ = sel => document.querySelector(sel);
const sleep = ms => new Promise(r => setTimeout(r, ms));

/* ============================================================
   4. PLATFORM PICKER
   ============================================================ */
function buildPicker() {
  const host = $('#platforms');
  for (const site of SITES) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'platform';
    b.dataset.id = site.id;
    b.title = site.name;
    b.innerHTML = `${ICONS[site.id]}<span>${site.short}</span>`;
    b.addEventListener('click', () => togglePlatform(site.id));
    host.appendChild(b);
  }
}

function togglePlatform(id) {
  selected.has(id) ? selected.delete(id) : selected.add(id);
  syncUi({ clearResults: true });
}

function syncUi({ clearResults = false } = {}) {
  document.querySelectorAll('.platform').forEach(el => {
    el.classList.toggle('on', selected.has(el.dataset.id));
  });

  const hasPlatform = selected.size > 0;
  const input = $('#username');
  input.disabled = !hasPlatform;
  input.placeholder = hasPlatform ? 'username (no @)' : 'Choose a platform first';
  if (!hasPlatform) input.value = '';

  if (clearResults) {
    results = [];
    renderResults();
    resetEmbed();
  }
  updateScanState();
}

function updateScanState() {
  const ready =
    !scanning &&
    selected.size > 0 &&
    $('#username').value.trim().replace(/^@/, '').length > 0;
  $('#scan').disabled = !ready;
}

/* ============================================================
   5. RENDER
   ============================================================ */
function renderResults() {
  const wrap = $('#results');
  wrap.innerHTML = '';
  for (const r of results) {
    const row = document.createElement('div');
    row.className = 'result';
    row.innerHTML = `
      ${ICONS[r.site.id]}
      <span class="dot ${r.status}"></span>
      <div class="meta">
        <div class="name">${r.site.name}</div>
        <div class="detail">${r.detail || '—'}</div>
      </div>
      <div class="actions"></div>
    `;
    const actions = row.querySelector('.actions');
    if (r.status === 'found') {
      const b = document.createElement('button');
      b.textContent = 'Embed';
      b.onclick = () => embedProfile(r);
      actions.appendChild(b);
    }
    const open = document.createElement('button');
    open.textContent = 'Open';
    open.onclick = () => window.open(r.url, '_blank', 'noopener');
    actions.appendChild(open);
    wrap.appendChild(row);
  }
}

function upsertResult(partial) {
  results = results.filter(r => r.site.id !== partial.site.id);
  results.push(partial);
  // keep display order identical to SITES order
  results.sort((a, b) =>
    SITES.findIndex(s => s.id === a.site.id) - SITES.findIndex(s => s.id === b.site.id)
  );
  renderResults();
}

/* ============================================================
   6. CHECK ENGINE
   ============================================================ */
async function checkSite(site, username) {
  const url = site.url(username);
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 12000);

  try {
    if (site.mode === 'oembed') {
      const res = await fetch(site.oembedUrl(username), { signal: controller.signal });
      if (res.status === 404) return { status: 'not_found', detail: 'oEmbed 404' };
      if (!res.ok) return { status: 'uncertain', detail: `oEmbed HTTP ${res.status}` };
      const data = await res.json();
      return { status: 'found', detail: 'oEmbed OK', embedHtml: data.html };
    }

    const res = await fetch(url, {
      redirect: 'follow',
      credentials: 'omit',
      signal: controller.signal,
      headers: { Accept: 'text/html' }
    });

    if (res.status === 404) return { status: 'not_found', detail: 'HTTP 404' };
    if (res.status >= 500) return { status: 'error', detail: `HTTP ${res.status}` };
    if (res.status !== 200) return { status: 'uncertain', detail: `HTTP ${res.status}` };

    const text = await res.text();
    for (const pat of site.notFoundPatterns || []) {
      if (pat.test(text)) return { status: 'not_found', detail: pat.source };
    }
    for (const pat of site.uncertainPatterns || []) {
      if (pat.test(text)) return { status: 'uncertain', detail: pat.source };
    }
    return { status: 'found', detail: 'HTTP 200' };
  } catch (err) {
    return {
      status: 'error',
      detail: err.name === 'AbortError' ? 'timeout' : (err.message || 'network error')
    };
  } finally {
    clearTimeout(timer);
  }
}

async function runScan() {
  if (scanning) return;

  const username = $('#username').value.trim().replace(/^@/, '');
  const active = SITES.filter(s => selected.has(s.id));
  if (!username || !active.length) return;

  scanning = true;
  $('#scan').disabled = true;
  results = [];
  renderResults();
  resetEmbed();

  for (let i = 0; i < active.length; i++) {
    const site = active[i];

    upsertResult({
      site,
      username,
      url: site.url(username),
      status: 'checking',
      detail: 'checking…'
    });

    const r = await checkSite(site, username);
    upsertResult({ ...r, site, username, url: site.url(username) });

    if (i < active.length - 1) {
      await sleep(700 + Math.random() * 900); // throttle: rate-limit safety
    }
  }

  scanning = false;
  updateScanState();
}

/* ============================================================
   7. EMBED DISPATCHER
   ============================================================ */
function resetEmbed() {
  $('#embed-title').textContent = 'Embed preview';
  $('#embed-container').innerHTML =
    '<div class="empty">Run a scan, then press “Embed” on a found profile.</div>';
}

async function embedProfile(r) {
  const container = $('#embed-container');
  container.innerHTML = '<div class="empty">loading embed…</div>';
  $('#embed-title').textContent = `Embed preview — ${r.site.name}`;

  try {
    switch (r.site.id) {
      case 'instagram': await embedInstagram(r.username, container); break;
      case 'x':         await embedX(r.username, container);         break;
      case 'tiktok':    await embedTikTok(r, container);             break;
      case 'facebook':  await embedFacebook(r.username, container);  break;
      case 'youtube':   embedYouTube(r.username, container);         break;
      default: throw new Error('no embed handler');
    }
  } catch (err) {
    container.innerHTML = `<div class="empty">Embed failed: ${err.message}</div>`;
  }
}

async function embedInstagram(username, container) {
  container.innerHTML = `
    <blockquote class="instagram-media"
      data-instgrm-permalink="https://www.instagram.com/${username}/"
      data-instgrm-version="14"
      style="width:100%; margin:0;">
    </blockquote>`;
  await loadScript('https://www.instagram.com/embed.js');
  if (window.instgrm) window.instgrm.Embeds.process();
}

async function embedX(username, container) {
  await loadScript('https://platform.twitter.com/widgets.js');
  container.innerHTML = '';
  if (!window.twttr || !twttr.widgets) throw new Error('widgets.js unavailable');
  await twttr.widgets.createTimeline(
    { sourceType: 'profile', screenName: username },
    container,
    { height: 500, chrome: 'noheader nofooter' }
  );
}

async function embedTikTok(r, container) {
  let html = r.embedHtml;
  if (!html) {
    const res = await fetch(r.site.oembedUrl(r.username));
    if (!res.ok) throw new Error(`oEmbed HTTP ${res.status}`);
    html = (await res.json()).html;
  }
  container.innerHTML = html;
  executeScripts(container);
  await loadScript('https://www.tiktok.com/embed.js');
}

async function embedFacebook(username, container) {
  await loadFacebookSDK();
  container.innerHTML = `
    <div class="fb-page"
      data-href="https://www.facebook.com/${username}"
      data-tabs="timeline"
      data-width="460"
      data-height="560"
      data-small-header="true"
      data-adapt-container-width="true"
      data-hide-cover="false"
      data-show-facepile="true">
    </div>`;
  if (window.FB) FB.XFBML.parse(container);
}

function embedYouTube(username, container) {
  const safe = encodeURIComponent(username);
  container.innerHTML = `
    <div class="empty" style="margin-bottom:8px;">
      YouTube channel embeds are deprecated — the legacy iframe may not render.
    </div>
    <iframe width="100%" height="260" frameborder="0" allowfullscreen
      src="https://www.youtube.com/embed?listType=user_uploads&list=${safe}">
    </iframe>
    <div style="margin-top:8px;">
      <button class="mini" onclick="window.open('https://www.youtube.com/@${safe}','_blank','noopener')">
        Open channel on YouTube
      </button>
    </div>`;
}

/* ============================================================
   8. SCRIPT LOADERS
   ============================================================ */
const loadedScripts = new Set();

function loadScript(src) {
  if (loadedScripts.has(src)) return Promise.resolve();
  return new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = src;
    s.async = true;
    s.onload = () => { loadedScripts.add(src); resolve(); };
    s.onerror = () => reject(new Error(`failed to load ${src}`));
    document.head.appendChild(s);
  });
}

function executeScripts(container) {
  container.querySelectorAll('script').forEach(old => {
    const s = document.createElement('script');
    if (old.src) s.src = old.src;
    else s.textContent = old.textContent;
    s.async = true;
    old.replaceWith(s);
  });
}

function loadFacebookSDK() {
  return new Promise((resolve, reject) => {
    if (window.FB) return resolve();
    window.fbAsyncInit = function () {
      FB.init({ xfbml: true, version: 'v25.0' });
      resolve();
    };
    const js = document.createElement('script');
    js.src = 'https://connect.facebook.net/en_US/sdk.js';
    js.async = true;
    js.onerror = () => reject(new Error('Facebook SDK failed'));
    document.body.appendChild(js);
  });
}

/* ============================================================
   9. BOOT
   ============================================================ */
buildPicker();

$('#all').addEventListener('click', () => {
  SITES.forEach(s => selected.add(s.id));
  syncUi({ clearResults: true });
});
$('#none').addEventListener('click', () => {
  selected.clear();
  syncUi({ clearResults: true });
});
$('#username').addEventListener('input', updateScanState);
$('#username').addEventListener('keydown', e => {
  if (e.key === 'Enter') runScan();
});
$('#scan').addEventListener('click', runScan);

syncUi(); // initial: input disabled, scan disabled
</script>
</body>
</html>
